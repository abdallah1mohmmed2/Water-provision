name: Generate Keystore
on:
  workflow_dispatch:

jobs:
  generate:
    runs-on: ubuntu-latest
    steps:
      - name: Generate JKS Keystore
        run: |
          keytool -genkey -v -keystore my-release-key.jks \
            -keyalg RSA -keysize 2048 -validity 10000 \
            -alias my-key-alias \
            -storepass 123456 \
            -keypass 123456 \
            -dname "CN=Abdullah Al-Jahrani, OU=Dev, O=JETS, L=Dhamar, S=Dhamar, C=YE"

      - name: Upload Keystore Artifact
        uses: actions/upload-artifact@v4
        with:
          name: my-keystore
          path: my-release-key.jks
